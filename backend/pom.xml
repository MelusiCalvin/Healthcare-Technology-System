<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>za.co.ubuntuhealth</groupId>
    <artifactId>ubuntu-health-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ubuntu Health Backend</name>
    <description>Modular-monolith backend for Ubuntu Health</description>

    <modules>
        <module>ubuntu-health-shared-kernel</module>
        <module>ubuntu-health-contracts</module>
        <module>modules/identity</module>
        <module>modules/organisation</module>
        <module>modules/patient</module>
        <module>modules/scheduling</module>
        <module>modules/clinical</module>
        <module>modules/nursing</module>
        <module>modules/pharmacy</module>
        <module>modules/diagnostics</module>
        <module>modules/finance</module>
        <module>modules/communication</module>
        <module>modules/documents</module>
        <module>modules/audit</module>
        <module>modules/integration</module>
        <module>modules/reporting</module>
        <module>ubuntu-health-bootstrap</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
