# Copy this file to .env and replace every development-only secret before starting Docker Compose.
POSTGRES_DB=ubuntu_health
POSTGRES_USER=ubuntu_health_owner
POSTGRES_PASSWORD=replace-with-a-long-unique-owner-password
POSTGRES_PORT=5432

APP_DATABASE_USERNAME=ubuntu_health_app
APP_DATABASE_PASSWORD=replace-with-a-long-unique-app-password

REDIS_PASSWORD=replace-with-a-long-unique-redis-password
REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=ubuntu_health_messaging
RABBITMQ_DEFAULT_PASS=replace-with-a-long-unique-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=ubuntu-health
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=ubuntu_health_storage
MINIO_ROOT_PASSWORD=replace-with-a-long-unique-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Used when the Spring Boot API runs directly on the host.
DATABASE_URL=jdbc:postgresql://localhost:5432/ubuntu_health
DATABASE_USERNAME=ubuntu_health_app
DATABASE_PASSWORD=replace-with-a-long-unique-app-password
APP_ENVIRONMENT=local
APP_VERSION=0.1.0-SNAPSHOT
